#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

/ {
    sensors {
        compatible = "zmk,keymap-sensors";
        sensors = <&left_encoder &right_encoder>;
        triggers-per-rotation = <20>;
    };
};

&led_strip { chain-length = <27>; };

&nice_view_spi { cs-gpios = <&pro_micro 8 GPIO_ACTIVE_HIGH>; };

/ {
    keymap {
        compatible = "zmk,keymap";

        Qwerty {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  | BKSP |
            // | CTRL |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  ;  |  '   |
            // | SHFT |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  | ESC  |
            //                    | GUI | LWR | SPC |   | ENT | RSE  | ALT |

            bindings = <
&kp ESCAPE     &kp Q  &kp W        &kp E       &kp R            &kp T        &kp Y        &kp U            &kp I            &kp O        &kp P     &kp MINUS
&kp TAB        &kp A  &mt LCTRL S  &mt LALT D  &mt LEFT_META F  &kp G        &kp H        &mt RIGHT_GUI J  &mt RIGHT_ALT K  &mt L RCTRL  &kp SEMI  &kp SQT
&kp BACKSPACE  &kp Z  &kp X        &kp C       &kp V            &kp B        &kp N        &kp M            &kp COMMA        &kp DOT      &kp FSLH  &kp NON_US_BACKSLASH
                                   &none       &kp BACKSPACE    &kp LSHFT    &lt 2 SPACE  &mo 1            &none
            >;

            sensor-bindings = <
                        &inc_dec_kp C_VOL_UP C_VOL_DN
                        &inc_dec_kp PG_UP PG_D
            >;
        };

        Symbol {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  1  |  2  |  3  |  4  |  5  |   |  6  |  7  |  8  |  9  |  0  | BKSP |
            // | BTCLR| BT1 | BT2 | BT3 | BT4 | BT5 |   | LFT | DWN |  UP | RGT |     |      |
            // | SHFT |     |     |     |     |     |   |     |     |     |     |     |      |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            bindings = <
&none  &kp KP_DIVIDE    &kp KP_ASTERISK  &kp KP_SUBTRACT  &kp KP_PLUS      &kp KP_EQUAL       &none            &kp LEFT_BRACKET      &kp RIGHT_BRACKET      &kp LEFT_BRACE  &kp RIGHT_BRACE    &kp GRAVE
&none  &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &kp KP_NUMBER_4  &kp KP_NUMBER_5    &kp EXCLAMATION  &kp AT_SIGN           &kp HASH               &kp DOLLAR      &kp PERCENT        &kp TILDE
&none  &kp KP_NUMBER_6  &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &kp KP_NUMBER_0    &kp CARET        &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp AMPERSAND   &kp DOUBLE_QUOTES  &none
                                         &none            &kp BACKSPACE    &none              &none            &trans                &none
            >;

            sensor-bindings = <
                                &inc_dec_kp C_VOL_UP C_VOL_DN 
                                &inc_dec_kp PG_UP PG_DN
            >;
        };

        Navi {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  !  |  @  |  #  |  $  |  %  |   |  ^  |  &  |  *  |  (  |  )  | BKSP |
            // | CTRL |     |     |     |     |     |   |  -  |  =  |  [  |  ]  |  \  |  `   |
            // | SHFT |     |     |     |     |     |   |  _  |  +  |  {  |  }  | "|" |  ~   |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            bindings = <
&none          &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 3  &bt BT_SEL 4  &bt BT_CLR    &kp K_MUTE      &kp C_VOL_DN   &kp C_VOLUME_UP  &none      &none  &none
&none          &kp F1        &kp F2        &kp F3        &kp F4        &kp F5        &kp LEFT_ARROW  &kp DOWN       &kp UP_ARROW     &kp RIGHT  &none  &none
&kp LS(ENTER)  &kp F6        &kp F7        &kp F8        &kp F9        &kp F10       &none           &kp PAGE_DOWN  &kp PG_UP        &none      &none  &kp DEL
                                           &none         &none         &kp ENTER     &none           &none          &none
            >;

            sensor-bindings = <
                                &inc_dec_kp C_VOL_UP C_VOL_DN 
                                &inc_dec_kp PG_UP PG_DN
            >;
        };
    };
};
