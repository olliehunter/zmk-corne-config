#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&mt { flavor = "tap-preferred"; };

/ {
    sensors {
        compatible = "zmk,keymap-sensors";
    };
};

/ {
    keymap {
        compatible = "zmk,keymap";

        Qwerty {
            bindings = <
&kp ESCAPE     &kp Q  &kp W        &kp E             &kp R            &kp T        &kp Y           &kp U  &kp I      &kp O    &kp P     &kp MINUS
&kp TAB        &kp A  &mt LCTRL S  &mt LALT D        &mt LEFT_META F  &kp G        &kp H           &kp J  &kp K      &kp L    &kp SEMI  &kp SQT
&kp BACKSPACE  &kp Z  &kp X        &kp C             &kp V            &kp B        &mt LEFT_GUI N  &kp M  &kp COMMA  &kp DOT  &kp FSLH  &kp BACKSLASH
                                   &kp LEFT_CONTROL  &kp BACKSPACE    &kp LSHFT    &lt 2 SPACE     &mo 1  &mo 3
            >;
        };

        Symbol {
            bindings = <
&none  &kp KP_DIVIDE  &kp KP_ASTERISK  &kp KP_SUBTRACT  &kp KP_PLUS    &kp EQUAL    &none            &kp LEFT_BRACKET      &kp RIGHT_BRACKET      &kp LEFT_BRACE  &kp RIGHT_BRACE    &kp GRAVE
&none  &kp N1         &kp N2           &kp N3           &kp N4         &kp N5       &kp EXCLAMATION  &kp AT_SIGN           &kp HASH               &kp DOLLAR      &kp PERCENT        &kp TILDE
&none  &kp N6         &kp N7           &kp N8           &kp N9         &kp N0       &kp CARET        &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp AMPERSAND   &kp DOUBLE_QUOTES  &kp LA(NUMBER_3)
                                       &none            &kp BACKSPACE  &none        &none            &trans                &none
            >;
        };

        Navi {
            bindings = <
&none          &none   &none   &none   &none   &none        &kp K_MUTE      &kp C_VOL_DN   &kp C_VOLUME_UP  &none      &none  &none
&none          &kp F1  &kp F2  &kp F3  &kp F4  &kp F5       &kp LEFT_ARROW  &kp DOWN       &kp UP_ARROW     &kp RIGHT  &none  &none
&kp LS(ENTER)  &kp F6  &kp F7  &kp F8  &kp F9  &kp F10      &none           &kp PAGE_DOWN  &kp PG_UP        &none      &none  &kp DEL
                               &none   &none   &kp ENTER    &none           &none          &none
            >;
        };

        Mouse {
            bindings = <
&bt BT_SEL 0  &bt BT_SEL 3  &none  &none  &none  &bt BT_CLR        &none           &none           &none         &none            &none  &none
&bt BT_SEL 1  &bt BT_SEL 4  &none  &none  &none  &none             &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_UP  &mmv MOVE_RIGHT  &none  &none
&bt BT_SEL 2  &none         &none  &none  &none  &bt BT_CLR_ALL    &msc SCRL_LEFT  &msc SCRL_DOWN  &msc SCRL_UP  &msc SCRL_RIGHT  &none  &none
                                   &none  &none  &none             &mkp MB1        &mkp MB2        &none
            >;
        };
    };
};
